#!/usr/bin/env python3
"""Run infiniswapctl from a source checkout or installed support directory."""

import importlib
import sys
from pathlib import Path

script = Path(__file__).resolve()
search_roots = (
    script.parent.parent,
    script.parent.parent / "lib" / "infiniswap",
    Path("/usr/lib/infiniswap"),
    Path("/usr/local/lib/infiniswap"),
)
for root in search_roots:
    if (root / "infiniswapctl" / "__main__.py").is_file():
        sys.path.insert(0, str(root))
        break
else:
    print("infiniswapctl: Python package is not installed", file=sys.stderr)
    raise SystemExit(1)

main = importlib.import_module("infiniswapctl.cli").main

raise SystemExit(main())
