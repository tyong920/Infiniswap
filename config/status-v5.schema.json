{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tyong920/Infiniswap/config/status-v5.schema.json",
  "title": "Infiniswap Device Status v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "device",
    "connection",
    "capacity",
    "mapping",
    "metrics",
    "last_error"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "kind": {
      "const": "infiniswap.device-status"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "lifecycle",
        "mode",
        "acknowledgement_policy",
        "operational_state",
        "provider_failure_deadline_ms",
        "swap"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^/dev/"
        },
        "lifecycle": {
          "enum": [
            "created",
            "active",
            "draining",
            "drained",
            "stopped"
          ]
        },
        "mode": {
          "enum": [
            "backed",
            "remote-only",
            "unset"
          ]
        },
        "acknowledgement_policy": {
          "enum": [
            "strict",
            "remote-first",
            "unset"
          ]
        },
        "operational_state": {
          "enum": [
            "healthy",
            "backing-degraded",
            "remote-lost"
          ]
        },
        "provider_failure_deadline_ms": {
          "type": "integer",
          "minimum": 500,
          "maximum": 30000
        },
        "swap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configured_priority",
            "enabled",
            "priority"
          ],
          "properties": {
            "configured_priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32767
            },
            "enabled": {
              "type": "boolean"
            },
            "priority": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": -1,
              "maximum": 32767
            }
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "total_providers",
        "healthy_providers",
        "providers"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-connected",
            "connecting",
            "connected",
            "degraded",
            "remote-lost"
          ]
        },
        "total_providers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "healthy_providers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "providers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider_id",
              "state"
            ],
            "properties": {
              "provider_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "state": {
                "enum": [
                  "not-connected",
                  "connecting",
                  "connected",
                  "degraded",
                  "remote-lost"
                ]
              }
            }
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advertised_bytes",
        "backing_bytes",
        "remote_bytes"
      ],
      "properties": {
        "advertised_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "backing_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "remote_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_size_bytes",
        "mapped_hot_ranges",
        "mapped_remote_chunks",
        "placement_sample_size",
        "placements",
        "excluded_providers",
        "read_weight",
        "threshold",
        "write_weight"
      ],
      "properties": {
        "chunk_size_bytes": {
          "const": 1073741824
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        },
        "read_weight": {
          "type": "integer",
          "minimum": 1
        },
        "write_weight": {
          "type": "integer",
          "minimum": 1
        },
        "mapped_hot_ranges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "mapped_remote_chunks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "placement_sample_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "placements": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "logical_chunk",
              "provider_id"
            ],
            "properties": {
              "logical_chunk": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "provider_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              }
            }
          }
        },
        "excluded_providers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider_id",
              "reason"
            ],
            "properties": {
              "provider_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backing_degraded_transitions_total",
        "backing_failures_total",
        "backing_invalid_sectors",
        "backing_retries_total",
        "late_rdma_completions_total",
        "local_only_writes_total",
        "provider_timeouts_total",
        "rejected_writes_total",
        "remote_lost_transitions_total"
      ],
      "properties": {
        "backing_degraded_transitions_total": {
          "type": "integer",
          "minimum": 0
        },
        "backing_failures_total": {
          "type": "integer",
          "minimum": 0
        },
        "backing_invalid_sectors": {
          "type": "integer",
          "minimum": 0
        },
        "backing_retries_total": {
          "type": "integer",
          "minimum": 0
        },
        "late_rdma_completions_total": {
          "type": "integer",
          "minimum": 0
        },
        "local_only_writes_total": {
          "type": "integer",
          "minimum": 0
        },
        "provider_timeouts_total": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_writes_total": {
          "type": "integer",
          "minimum": 0
        },
        "remote_lost_transitions_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "last_error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "errno"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^E[A-Z0-9_]+$"
            },
            "errno": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
