{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tyong920/Infiniswap/config/consumer.schema.json",
  "title": "Infiniswap Memory Consumer Configuration v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "device"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "identity": {
      "$ref": "#/definitions/consumer_identity"
    },
    "device": {
      "$ref": "#/definitions/device"
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "device_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "consumer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "remote_only_eligible"
      ],
      "properties": {
        "consumer_id": {
          "$ref": "#/definitions/identifier"
        },
        "remote_only_eligible": {
          "type": "boolean"
        }
      }
    },
    "hot_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_threshold",
        "read_weight",
        "write_weight"
      ],
      "properties": {
        "mapping_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "read_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "write_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mode",
        "capacity_bytes",
        "provider_failure_deadline_ms",
        "provider_directory",
        "providers",
        "swap_priority"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/device_name"
        },
        "mode": {
          "enum": [
            "backed",
            "remote-only"
          ]
        },
        "acknowledgement_policy": {
          "enum": [
            "strict",
            "remote-first"
          ],
          "default": "strict"
        },
        "backing_store": {
          "$ref": "#/definitions/absolute_path"
        },
        "capacity_bytes": {
          "type": "integer",
          "minimum": 1073741824,
          "maximum": 137438953472,
          "multipleOf": 1073741824
        },
        "provider_failure_deadline_ms": {
          "type": "integer",
          "minimum": 500,
          "maximum": 30000
        },
        "hot_range": {
          "$ref": "#/definitions/hot_range"
        },
        "provider_directory": {
          "$ref": "#/definitions/absolute_path"
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/identifier"
          }
        },
        "swap_priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "backed"
              }
            }
          },
          "then": {
            "required": [
              "backing_store",
              "hot_range"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "remote-only"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "acknowledgement_policy"
                  ]
                },
                {
                  "required": [
                    "backing_store"
                  ]
                },
                {
                  "required": [
                    "hot_range"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "device": {
            "properties": {
              "mode": {
                "const": "remote-only"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "remote_only_eligible": {
                "const": true
              }
            },
            "required": [
              "remote_only_eligible"
            ]
          }
        }
      }
    }
  ]
}
