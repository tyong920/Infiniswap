{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tyong920/Infiniswap/provider-directory.schema.json",
  "title": "Infiniswap Provider Directory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/provider"
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "key_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "capability": {
      "enum": [
        "backed",
        "remote_only",
        "opportunistic_pool",
        "committed_pool",
        "provider_failure_deadline",
        "status",
        "auth_hmac_sha256"
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "port",
        "rdma_rail",
        "authentication",
        "expected_capabilities",
        "placement_weight"
      ],
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "rdma_rail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device", "port", "numa_node"],
          "properties": {
            "device": {
              "$ref": "#/definitions/identifier"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "numa_node": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consumer_id", "key_id", "psk_file"],
          "properties": {
            "consumer_id": {
              "$ref": "#/definitions/identifier"
            },
            "key_id": {
              "$ref": "#/definitions/key_identifier"
            },
            "psk_file": {
              "type": "string",
              "minLength": 2,
              "maxLength": 4096,
              "pattern": "^/"
            }
          }
        },
        "expected_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/capability"
          }
        },
        "placement_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
