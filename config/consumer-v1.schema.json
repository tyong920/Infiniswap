{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tyong920/Infiniswap/config/consumer-v1.schema.json",
  "title": "Infiniswap Memory Consumer Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "device"],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {"$ref": "#/definitions/consumer_identity"},
    "device": {"$ref": "#/definitions/device"}
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "device_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "consumer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer_id"],
      "properties": {
        "consumer_id": {"$ref": "#/definitions/identifier"}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mode",
        "capacity_bytes",
        "provider_failure_deadline_ms",
        "provider_directory",
        "providers",
        "swap_priority"
      ],
      "properties": {
        "name": {"$ref": "#/definitions/device_name"},
        "mode": {"enum": ["backed", "remote-only"]},
        "acknowledgement_policy": {"enum": ["strict", "remote-first"]},
        "backing_store": {"$ref": "#/definitions/absolute_path"},
        "capacity_bytes": {
          "type": "integer",
          "minimum": 1073741824,
          "maximum": 137438953472,
          "multipleOf": 1073741824
        },
        "provider_failure_deadline_ms": {
          "type": "integer",
          "minimum": 500,
          "maximum": 30000
        },
        "provider_directory": {"$ref": "#/definitions/absolute_path"},
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/identifier"}
        },
        "swap_priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "backed"}}},
          "then": {"required": ["acknowledgement_policy", "backing_store"]}
        },
        {
          "if": {"properties": {"mode": {"const": "remote-only"}}},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["acknowledgement_policy"]},
                {"required": ["backing_store"]}
              ]
            }
          }
        }
      ]
    }
  }
}
