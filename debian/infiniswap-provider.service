[Unit]
Description=Infiniswap Memory Provider
Documentation=file:/usr/share/doc/infiniswap-provider/packaging.md.gz
Wants=network-online.target
After=network-online.target rdma-hw.target
ConditionPathExists=/etc/infiniswap/provider-memory.conf
ConditionPathExists=/etc/infiniswap/consumers.conf

[Service]
Type=simple
EnvironmentFile=/etc/default/infiniswap-provider
ExecStart=/usr/sbin/infiniswap-daemon ${INFINISWAP_LISTEN_ADDRESS} ${INFINISWAP_LISTEN_PORT} ${INFINISWAP_MEMORY_CONFIG} ${INFINISWAP_CONSUMER_ALLOWLIST}
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=35s
LimitMEMLOCK=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
